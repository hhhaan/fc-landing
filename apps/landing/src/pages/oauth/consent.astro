---
import { PUBLIC_SUPABASE_URL } from 'astro:env/client';
import {
    MCP_OAUTH_CLIENT_IDS,
    MCP_OAUTH_ENABLED,
    MCP_OAUTH_ISSUER_URL,
    MCP_OAUTH_READONLY_READY,
    MCP_OAUTH_REDIRECT_URIS,
    MCP_OAUTH_RESOURCE_URL,
} from 'astro:env/server';
import Favicon from '../../components/ui/Favicon.astro';
import { CONSENT_COOKIE, handleMcpConsent } from '../../lib/mcpConsent';
import { issuerConsentClient } from '../../lib/mcpIssuer';
import { createClient } from '../../lib/supabase';

const client = createClient({ request: Astro.request, cookies: Astro.cookies });
const auth = issuerConsentClient(client, PUBLIC_SUPABASE_URL);
let form: FormData | undefined;
if (Astro.request.method === 'POST') {
    try {
        form = await Astro.request.formData();
    } catch {
        /* Invalid requests fail the CSRF check. */
    }
}
const state = await handleMcpConsent(
    Astro.request,
    auth,
    {
        enabled: MCP_OAUTH_ENABLED === 'true',
        readOnlyReady: MCP_OAUTH_READONLY_READY === 'true',
        issuer: MCP_OAUTH_ISSUER_URL ?? '',
        resource: MCP_OAUTH_RESOURCE_URL ?? '',
        clientIds: (MCP_OAUTH_CLIENT_IDS ?? '')
            .split(',')
            .map((id) => id.trim())
            .filter(Boolean),
        redirectUris: (MCP_OAUTH_REDIRECT_URIS ?? '')
            .split(',')
            .map((uri) => uri.trim())
            .filter(Boolean),
    },
    Astro.cookies.get(CONSENT_COOKIE)?.value,
    form,
);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Frame-Options', 'DENY');
if (Astro.request.method === 'POST') Astro.cookies.delete(CONSENT_COOKIE, { path: '/oauth/consent' });
if (state.kind === 'login' || state.kind === 'redirect') return Astro.redirect(state.location, 303);
const csrf = state.kind === 'review' ? `${state.authorizationId}.${crypto.randomUUID()}` : '';
if (csrf)
    Astro.cookies.set(CONSENT_COOKIE, csrf, {
        path: '/oauth/consent',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 600,
    });
if (state.kind === 'unavailable') Astro.response.status = state.status;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <Favicon />
    <title>Connect your workspace — First Crack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body class="ox">
    <main class="ox-auth">
      <header class="ox-auth-header"><a href="/" class="ox-brand">First Crack</a></header>
      <section class="ox-auth-card" aria-labelledby="consent-title">
        <p class="ox-eyebrow">Workspace connection</p>
        <h1 id="consent-title">Connect your workspace</h1>
        {state.kind === 'review' ? <>
          <p><strong>{state.clientName}</strong> is asking to read a roastery workspace you choose.</p>
          <p>Signed in as <strong>{state.accountLabel}</strong>.</p>
          <ul>
            <li>Your profile, green beans and products</li>
            <li>Order quantities and stored production plans</li>
            <li>Saved roast history</li>
          </ul>
          <p>Access stays limited to the selected workspace, including when this connection is refreshed.</p>
          <p>This connection cannot register production, change inventory or control equipment.</p>
          <p class="ox-muted">You will return to {new URL(state.redirectUri).origin}.</p>
          <form method="POST">
            <input type="hidden" name="csrf" value={csrf} />
            <label for="workspace">Roastery</label>
            <select id="workspace" name="workspace_owner_id" required>
              {state.workspaces.map((workspace) => <option value={workspace.owner_id}>{workspace.name}</option>)}
            </select>
            <button type="submit" name="decision" value="approve" class="ox-btn ox-btn-solid">Allow read access</button>
            <button type="submit" name="decision" value="deny" class="ox-btn ox-btn-outline">Deny</button>
          </form>
          <p class="ox-muted">You can revoke access from <a href="/account/connections">Connected apps</a> or the connected app.</p>
        </> : <p role="status">{state.message}</p>}
      </section>
    </main>
  </body>
</html>
<style>
body.ox { --ox-bg: #fafaf9; --ox-fg: #080503; --ox-muted: #5e534a; --ox-border: rgba(8,5,3,.12); margin: 0; background: var(--ox-bg); color: var(--ox-fg); font-family: 'Instrument Sans',system-ui,sans-serif; line-height: 1.6; }
.ox-auth-header { padding: 24px; border-bottom: 1px solid var(--ox-border); }
.ox-brand { color: inherit; font-size: 20px; font-weight: 600; text-decoration: none; }
.ox-auth-card { max-width: 520px; margin: 64px auto; padding: 40px; border: 1px solid var(--ox-border); background: white; }
.ox-eyebrow { font: 12px 'JetBrains Mono',monospace; text-transform: uppercase; color: var(--ox-muted); }
h1 { font-size: clamp(1.75rem,4vw,2.25rem); font-weight: 500; letter-spacing: -.03em; line-height: 1.2; }
.ox-muted { color: var(--ox-muted); font-size: 14px; overflow-wrap: anywhere; }
form { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.ox-btn { min-height: 48px; padding: 12px 20px; border: 1px solid var(--ox-fg); border-radius: 0; font: inherit; cursor: pointer; }
.ox-btn-solid { background: var(--ox-fg); color: white; }
.ox-btn-outline { background: transparent; color: var(--ox-fg); }
.ox-btn:focus-visible { outline: 2px solid var(--ox-fg); outline-offset: 3px; }
@media(max-width:640px) { .ox-auth-card { margin: 32px 16px; padding: 24px; } }
</style>
