---
import { PUBLIC_SUPABASE_URL } from 'astro:env/client';
import { POLAR_ACCESS_TOKEN, POLAR_LEGACY_ACCESS_TOKEN, SUPABASE_SERVICE_ROLE_KEY } from 'astro:env/server';
import { createClient } from '@supabase/supabase-js';
import { requireLogin } from '../lib/auth';
import { polarApiBase } from '../lib/polarPlans';

const userOrRedirect = await requireLogin(Astro, `${Astro.url.pathname}${Astro.url.search}`);
if (userOrRedirect instanceof Response) return userOrRedirect;
const user = userOrRedirect;
const oldOrg = 'f0ef6666-e89c-4a50-8808-78ff4b4d3a1d';
const newOrg = '3b6494cb-8248-47d1-a5f2-65ff7ca9b8a8';
const requestedOrg = Astro.url.searchParams.get('organization');
if (requestedOrg && requestedOrg !== oldOrg && requestedOrg !== newOrg)
    return Astro.redirect('/account?billing=unavailable');
const supabase = createClient(PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY);
const { data: customers, error } = await supabase
    .from('billing_customers')
    .select('polar_organization_id,polar_customer_id')
    .eq('user_id', user.id);
if (error) return Astro.redirect('/account?billing=error');
// A known old profile ID is legacy-only. Never retry it with the new organization's token.
let customer = customers?.find((row) => row.polar_organization_id === (requestedOrg ?? newOrg));
if (!customer && (!requestedOrg || requestedOrg === oldOrg)) {
    customer = customers?.find((row) => row.polar_organization_id === oldOrg);
    if (!customer && !customers?.length) {
        const { data: profile, error: profileError } = await supabase
            .from('profiles')
            .select('polar_customer_id')
            .eq('id', user.id)
            .maybeSingle();
        if (profileError) return Astro.redirect('/account?billing=error');
        if (profile?.polar_customer_id)
            customer = { polar_organization_id: oldOrg, polar_customer_id: profile.polar_customer_id };
    }
}
if (!customer) return Astro.redirect('/account?billing=unavailable');
const token = customer.polar_organization_id === oldOrg ? POLAR_LEGACY_ACCESS_TOKEN : POLAR_ACCESS_TOKEN;
if (!token) return Astro.redirect('/account?billing=unavailable');
const res = await fetch(`${polarApiBase()}/v1/customer-sessions/`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
        customer_id: customer.polar_customer_id,
        return_url: new URL('/account', Astro.url.origin).href,
    }),
});
if (!res.ok) return Astro.redirect('/account?billing=error');
let session: { customer_portal_url?: string };
try {
    session = await res.json();
} catch {
    return Astro.redirect('/account?billing=error');
}
if (!session.customer_portal_url) return Astro.redirect('/account?billing=error');
return Astro.redirect(session.customer_portal_url);
---
