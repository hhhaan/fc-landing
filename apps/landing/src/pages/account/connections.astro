---
import { PUBLIC_SUPABASE_URL } from 'astro:env/client';
import { MCP_OAUTH_ENABLED, MCP_OAUTH_READONLY_READY } from 'astro:env/server';
import Favicon from '../../components/ui/Favicon.astro';
import { CONNECTION_COOKIE, handleMcpConnections } from '../../lib/mcpConnections';
import { issuerConsentClient } from '../../lib/mcpIssuer';
import { createClient } from '../../lib/supabase';

const auth = issuerConsentClient(createClient({ request: Astro.request, cookies: Astro.cookies }), PUBLIC_SUPABASE_URL);
let form: FormData | undefined;
if (Astro.request.method === 'POST') {
    try {
        form = await Astro.request.formData();
    } catch {
        /* Controller rejects invalid CSRF. */
    }
}
const state = await handleMcpConnections(
    Astro.request,
    auth,
    MCP_OAUTH_ENABLED === 'true' && MCP_OAUTH_READONLY_READY === 'true',
    Astro.cookies.get(CONNECTION_COOKIE)?.value,
    form,
);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Frame-Options', 'DENY');
if (Astro.request.method === 'POST') Astro.cookies.delete(CONNECTION_COOKIE, { path: '/account/connections' });
if (state.kind === 'login' || state.kind === 'redirect') return Astro.redirect(state.location, 303);
if (state.kind === 'unavailable') Astro.response.status = state.status;
const csrf = state.kind === 'list' ? crypto.randomUUID() : '';
if (csrf)
    Astro.cookies.set(CONNECTION_COOKIE, csrf, {
        path: '/account/connections',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 600,
    });
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <Favicon />
    <title>Connected apps — First Crack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body class="ox">
    <main>
      <header><a href="/account">First Crack account</a></header>
      <section aria-labelledby="connections-title">
        <p class="eyebrow">Account access</p>
        <h1 id="connections-title">Connected apps</h1>
        <p>Each connection can read one roastery workspace. Revoke access here at any time.</p>
        {state.kind === 'unavailable' ? <p role="alert">Connections could not be loaded. Try again later.</p> : <>
          {!state.grants.length && <p>No connected apps.</p>}
          <ul>{state.grants.map((grant) => {
            const active = !grant.revoked_at && Date.parse(grant.expires_at) > Date.now();
            return <li>
              <h2>{grant.client_name}</h2>
              <p>{grant.workspace_name} · Read access</p>
              <p class="muted">{grant.revoked_at ? 'Revoked' : active ? `Expires ${new Date(grant.expires_at).toLocaleDateString('en-US', { timeZone: 'UTC' })}` : 'Expired'}</p>
              {active && <form method="POST">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="grant_id" value={grant.id} />
                <button type="submit">Revoke access</button>
              </form>}
            </li>;
          })}</ul>
          <p class="muted">Showing the 100 most recent connections.</p>
        </>}
      </section>
    </main>
  </body>
</html>
<style>
body.ox { --ox-bg:#fafaf9; --ox-fg:#080503; --ox-muted:#5e534a; --ox-border:rgba(8,5,3,.12); margin:0; background:var(--ox-bg); color:var(--ox-fg); font-family:'Instrument Sans',system-ui,sans-serif; line-height:1.6; }
header { padding:24px; border-bottom:1px solid var(--ox-border); }
a { color:inherit; }
section { max-width:600px; margin:64px auto; padding:32px; background:white; border:1px solid var(--ox-border); }
.eyebrow { font:12px 'JetBrains Mono',monospace; text-transform:uppercase; color:var(--ox-muted); }
h1 { font-size:2rem; font-weight:500; letter-spacing:-.03em; }
h2 { font-size:1.125rem; font-weight:500; }
ul { padding:0; list-style:none; }
li { border-top:1px solid var(--ox-border); padding:20px 0; }
.muted { color:var(--ox-muted); font-size:14px; }
button { min-height:48px; padding:12px 20px; border:1px solid var(--ox-fg); border-radius:0; background:transparent; color:inherit; font:inherit; cursor:pointer; }
button:focus-visible, a:focus-visible { outline:2px solid var(--ox-fg); outline-offset:3px; }
@media(max-width:640px) { section { margin:32px 16px; padding:24px; } }
</style>
