---
import '../styles/ox.css';
import Favicon from '../components/ui/Favicon.astro';
import Seo from '../components/ui/Seo.astro';
import { safeRedirectPath } from '../lib/safeRedirect';
import { createClient } from '../lib/supabase';

const supabaseServer = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

const next = safeRedirectPath(Astro.url.searchParams.get('next'));

const {
    data: { user },
} = await supabaseServer.auth.getUser();

if (user) {
    return Astro.redirect(next);
}

const loginHref = '/login';
const expired = Astro.url.searchParams.get('error') === 'expired';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <Favicon />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Reset your First Crack password — roast profiling and production software for specialty coffee roasteries."
    />
    <title>Forgot password — First Crack</title>
    <Seo title="Forgot password — First Crack" description="Reset your First Crack password — roast profiling and production software for specialty coffee roasteries." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="ox">
    <main class="ox-auth noise-overlay">
      <div class="ox-grid-bg" aria-hidden="true"></div>

      <header class="ox-auth-header">
        <nav class="ox-auth-nav">
          <a href="/" class="ox-brand">
            <span class="ox-brand-name">First Crack</span>
          </a>
          <div class="ox-auth-nav-end">
            <span class="ox-auth-hint">Remembered it?</span>
            <a href={loginHref} class="ox-btn ox-btn-outline ox-btn-sm">
              Sign in
            </a>
          </div>
        </nav>
      </header>

      <div class="ox-auth-main">
        <div class="ox-auth-card">
          <div class="ox-auth-head">
            <div class="ox-eyebrow">
              <span class="ox-line"></span>
              Account
            </div>
            <h1 class="ox-auth-title">Forgot password</h1>
            <p class="ox-auth-lead">
              Enter the email for your account. If it exists, we’ll send reset instructions.
            </p>
          </div>

          {expired && (
            <p class="ox-auth-error ox-auth-banner" role="status">
              That reset link expired or is invalid. Request a new one below.
            </p>
          )}

          <form id="forgot-form" class="ox-auth-form">
            <div class="ox-field">
              <label for="email">Email</label>
              <input
                id="email"
                type="email"
                name="email"
                class="ox-input"
                placeholder="you@roastery.com"
                autocomplete="email"
                required
              />
            </div>

            <p id="error-msg" class="ox-auth-error" hidden></p>
            <p id="success-msg" class="ox-auth-success" hidden></p>

            <button type="submit" id="submit-btn" class="ox-btn ox-btn-solid ox-btn-block">
              Send reset link
            </button>
          </form>

          <p class="ox-auth-foot">
            <a href={loginHref}>Back to sign in</a>
          </p>
        </div>
      </div>
    </main>

    <script>
      import { createBrowserClient } from "@supabase/ssr";
      import { webAuthCallbackUrl } from "../lib/safeRedirect";

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL!,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY!,
      );

      const redirectTo = webAuthCallbackUrl(window.location.origin, "/reset-password");
      const COOLDOWN_MS = 45_000;

      document.getElementById("forgot-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearMessages();

        const email = (document.getElementById("email") as HTMLInputElement).value.trim();
        const btn = document.getElementById("submit-btn") as HTMLButtonElement;

        btn.disabled = true;
        btn.textContent = "Sending…";

        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo,
        });

        // Always show success for non-network cases — avoid email enumeration.
        if (error && isNetworkError(error.message)) {
          showError(error.message);
          btn.disabled = false;
          btn.textContent = "Send reset link";
          return;
        }

        showSuccess(
          "If an account exists for that email, we sent reset instructions. Check your inbox.",
        );
        startCooldown(btn);
      });

      function startCooldown(btn: HTMLButtonElement) {
        const ends = Date.now() + COOLDOWN_MS;
        const tick = () => {
          const left = Math.ceil((ends - Date.now()) / 1000);
          if (left <= 0) {
            btn.disabled = false;
            btn.textContent = "Send reset link";
            return;
          }
          btn.disabled = true;
          btn.textContent = `Resend in ${left}s`;
          requestAnimationFrame(() => setTimeout(tick, 250));
        };
        tick();
      }

      function isNetworkError(msg: string) {
        return /failed to fetch|network|offline|load failed/i.test(msg);
      }

      function showError(msg: string) {
        const el = document.getElementById("error-msg")!;
        el.textContent = msg;
        el.hidden = false;
        document.getElementById("success-msg")!.hidden = true;
      }

      function showSuccess(msg: string) {
        const el = document.getElementById("success-msg")!;
        el.textContent = msg;
        el.hidden = false;
        document.getElementById("error-msg")!.hidden = true;
      }

      function clearMessages() {
        document.getElementById("error-msg")!.hidden = true;
        document.getElementById("success-msg")!.hidden = true;
      }
    </script>
  </body>
</html>

<style is:global>
  body.ox {
    --ox-bg: #fafaf9;
    --ox-fg: #080503;
    --ox-muted: #5e534a;
    --ox-muted-bg: #ecebe7;
    --ox-border: rgba(8, 5, 3, 0.06);
    --ox-border-strong: rgba(8, 5, 3, 0.12);
    --ox-sans: "Instrument Sans", system-ui, -apple-system, sans-serif;
    --ox-mono: "JetBrains Mono", ui-monospace, monospace;
    --ox-max: 1400px;
    --ox-pad: 24px;

    margin: 0;
    background: var(--ox-bg);
    color: var(--ox-fg);
    font-family: var(--ox-sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body.ox *,
  body.ox *::before,
  body.ox *::after {
    box-sizing: border-box;
  }

  body.ox a {
    color: inherit;
    text-decoration: none;
  }

  body.ox button {
    font-family: inherit;
    cursor: pointer;
  }

  .ox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 0;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: -0.01em;
    border: 1px solid transparent;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
    white-space: nowrap;
  }

  .ox-btn-sm {
    height: 32px;
    padding: 0 20px;
    font-size: 13px;
  }

  .ox-btn-block {
    width: 100%;
    height: 48px;
    font-size: 15px;
  }

  body.ox a.ox-btn-solid,
  body.ox .ox-btn-solid {
    background: var(--ox-fg);
    color: #fff;
    border-color: var(--ox-fg);
  }

  body.ox a.ox-btn-solid:hover,
  body.ox .ox-btn-solid:hover {
    opacity: 0.9;
  }

  .ox-btn-outline {
    background: transparent;
    color: var(--ox-fg);
    border-color: var(--ox-border-strong);
  }

  .ox-btn-outline:hover {
    background: rgba(8, 5, 3, 0.03);
    border-color: rgba(8, 5, 3, 0.28);
  }

  .ox-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ox-brand-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .ox-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ox-mono);
    font-size: 13px;
    color: var(--ox-muted);
    margin-bottom: 20px;
  }

  .ox-line {
    display: block;
    width: 32px;
    height: 1px;
    background: rgba(8, 5, 3, 0.3);
    flex-shrink: 0;
  }

  .noise-overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .ox-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    background-image:
      linear-gradient(var(--ox-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--ox-border) 1px, transparent 1px);
    background-size: 12.5% 12.5%;
  }

  .ox-auth {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ox-auth-header {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--ox-border);
    background: rgba(250, 250, 249, 0.85);
    backdrop-filter: blur(16px);
  }

  .ox-auth-nav {
    max-width: var(--ox-max);
    margin: 0 auto;
    padding: 0 var(--ox-pad);
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .ox-auth-nav-end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ox-auth-hint {
    display: none;
    font-size: 14px;
    color: var(--ox-muted);
  }

  @media (min-width: 640px) {
    .ox-auth-hint {
      display: inline;
    }
  }

  .ox-auth-main {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px var(--ox-pad) 64px;
  }

  .ox-auth-card {
    width: 100%;
    max-width: 420px;
    padding: 40px 32px;
    border: 1px solid var(--ox-border);
    background: #fff;
  }

  @media (min-width: 640px) {
    .ox-auth-card {
      padding: 48px 40px;
    }
  }

  .ox-auth-head {
    margin-bottom: 32px;
  }

  .ox-auth-title {
    margin: 0 0 12px;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .ox-auth-lead {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ox-muted);
  }

  .ox-auth-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ox-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ox-field label {
    font-size: 13px;
    font-weight: 500;
    color: rgba(8, 5, 3, 0.75);
  }

  .ox-input {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--ox-border-strong);
    border-radius: 0;
    background: var(--ox-bg);
    color: var(--ox-fg);
    font-family: var(--ox-sans);
    font-size: 15px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .ox-input::placeholder {
    color: rgba(94, 83, 74, 0.55);
  }

  .ox-input:focus {
    outline: none;
    border-color: var(--ox-fg);
    background: #fff;
  }

  .ox-auth-error {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #b42318;
    text-align: center;
  }

  .ox-auth-success {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #027a48;
    text-align: center;
  }

  .ox-auth-banner {
    margin-bottom: 20px;
    text-align: left;
  }

  .ox-auth-foot {
    margin: 28px 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--ox-muted);
  }

  .ox-auth-foot a {
    color: var(--ox-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ox-auth-foot a:hover {
    opacity: 0.75;
  }

  @media (min-width: 1024px) {
    body.ox {
      --ox-pad: 48px;
    }
  }
</style>
